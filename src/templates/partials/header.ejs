<%
const currentPageKey = typeof pageKey !== "undefined" ? pageKey : "home";
const rootHref = typeof basePath !== "undefined" ? basePath : "/";
const headerNavItems = [
  { href: "#company", label: "О компании" },
  { href: "#catalog", label: "Каталог" },
  { href: "#delivery", label: "Доставка и оплата" },
  { href: "#contacts", label: "Контакты" },
];
const headerSwitcherItems = [
  { href: `${rootHref}new.html`, key: "new", label: "Новые" },
  { href: `${rootHref}used.html`, key: "used", label: "Б/у" },
];
const headerPhoneByPage = {
  new: { href: "tel:+375296974177", label: "+375 (29) 697-41-77" },
  used: { href: "tel:+375296974777", label: "+375 (29) 697-47-77" },
};
const headerPhone = headerPhoneByPage[currentPageKey] || headerPhoneByPage.new;
%>

<header class="site-header<%= currentPageKey === 'home' ? ' site-header--home' : '' %>">
  <div class="site-header__inner">
    <% if (currentPageKey !== "home") { %>
      <a class="site-brand site-brand--text-only" href="<%= rootHref %>" aria-label="Вернуться на страницу выбора поддонов">
        <span class="site-brand__word">Поддоны</span>
      </a>
    <% } %>

    <% if (currentPageKey !== "home") { %>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-header-menu"
        aria-label="Открыть меню"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    <% } %>

    <div class="site-header__menu" id="site-header-menu">
      <% if (currentPageKey !== "home") { %>
        <nav class="site-nav" aria-label="Основная навигация">
          <% headerNavItems.forEach((item) => { %>
            <a data-i18n="<%= item.href === '#company' ? 'about' : item.href === '#catalog' ? 'catalog' : item.href === '#delivery' ? 'delivery' : 'contacts' %>" href="<%= item.href %>"><%= item.label %></a>
          <% }) %>
        </nav>
      <% } %>

      <div class="site-switcher" aria-label="Переключение между видами поддонов">
        <% headerSwitcherItems.forEach((item) => { %>
          <a
            class="site-switcher__link<%= currentPageKey === item.key ? ' site-switcher__link--active' : '' %>"
            href="<%= item.href %>"
          >
            <span data-i18n="<%= item.key %>"><%= item.label %></span>
          </a>
        <% }) %>
      </div>

      <% if (currentPageKey !== "home") { %>
        <div class="site-language" aria-label="Language / Sprache">
          <% ['ru', 'en', 'de'].forEach((language) => { %>
            <a class="site-language__link" data-language="<%= language %>" href="?lang=<%= language %>"><%= language.toUpperCase() %></a>
          <% }) %>
        </div>
      <% } %>

      <% if (currentPageKey !== "home") { %>
        <a
          class="site-instagram"
          href="https://www.instagram.com/used_pallets_by/"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram: @used_pallets_by"
          title="Instagram: @used_pallets_by"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M8 2h8a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6V8a6 6 0 0 1 6-6Zm0 2.2A3.8 3.8 0 0 0 4.2 8v8A3.8 3.8 0 0 0 8 19.8h8a3.8 3.8 0 0 0 3.8-3.8V8A3.8 3.8 0 0 0 16 4.2H8Zm4 3.3a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2.2a2.3 2.3 0 1 0 0 4.6 2.3 2.3 0 0 0 0-4.6Zm4.8-2.7a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z" />
          </svg>
          <span>@used_pallets_by</span>
        </a>

        <a class="site-phone" href="<%= headerPhone.href %>">
          <span class="site-phone__icon" aria-hidden="true">✆</span>
          <span class="site-phone__text">
            <strong><%= headerPhone.label %></strong>
            <em data-i18n="hours">Ежедневно с 9:00 до 18:00</em>
          </span>
        </a>
      <% } %>
    </div>
  </div>
</header>
